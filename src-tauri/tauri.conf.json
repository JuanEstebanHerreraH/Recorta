{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recorta",
  "version": "../package.json",
  "identifier": "app.recorta.escritorio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Recorta",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Quita fondos y exporta PNG con el tamaño, DPI y peso correctos",
    "longDescription": "Recortador de imágenes gratis y offline: IA local para quitar fondos, pinceles para corregir, y exportación PNG, WebP o JPG con tamaño, DPI y peso explicados.",
    "copyright": "Copyright (c) 2026 Recorta. Licencia MIT.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
